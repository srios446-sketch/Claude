{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evasof-plan-v1",
  "title": "Plan importado (rutina y/o dieta) - formato evasof-plan v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "formato": {
      "const": "evasof-plan"
    },
    "version": {
      "const": 1
    },
    "rutina": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "nombre": {
              "type": "string",
              "minLength": 1
            },
            "fecha_inicio": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            },
            "notas_generales": {
              "type": [
                "string",
                "null"
              ]
            },
            "dias": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^D[0-9]+$"
                  },
                  "nombre": {
                    "type": "string",
                    "minLength": 1
                  },
                  "dia_semana": {
                    "enum": [
                      "lunes",
                      "martes",
                      "miercoles",
                      "jueves",
                      "viernes",
                      "sabado",
                      "domingo",
                      null
                    ]
                  },
                  "tipo_dia_dieta": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "pattern": "^TD[0-9]+$"
                  },
                  "ejercicios": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "orden": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "nombre": {
                          "type": "string",
                          "minLength": 1
                        },
                        "grupos_musculares": {
                          "type": "array",
                          "items": {
                            "enum": [
                              "pecho",
                              "espalda",
                              "hombro",
                              "trapecio",
                              "biceps",
                              "triceps",
                              "antebrazo",
                              "abdomen",
                              "lumbar",
                              "cuadriceps",
                              "femoral",
                              "gluteo",
                              "aductores",
                              "abductores",
                              "pantorrilla",
                              "cuerpo_completo"
                            ]
                          },
                          "minItems": 1,
                          "uniqueItems": true
                        },
                        "series": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "series_calentamiento": {
                          "type": [
                            "integer",
                            "null"
                          ],
                          "minimum": 0
                        },
                        "tipo_reps": {
                          "enum": [
                            "reps",
                            "segundos",
                            "fallo",
                            "amrap"
                          ]
                        },
                        "reps_min": {
                          "type": [
                            "number",
                            "null"
                          ],
                          "minimum": 0
                        },
                        "reps_max": {
                          "type": [
                            "number",
                            "null"
                          ],
                          "minimum": 0
                        },
                        "series_detalle": {
                          "type": [
                            "array",
                            "null"
                          ],
                          "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                              "serie": {
                                "type": "integer",
                                "minimum": 1
                              },
                              "reps_min": {
                                "type": [
                                  "number",
                                  "null"
                                ],
                                "minimum": 0
                              },
                              "reps_max": {
                                "type": [
                                  "number",
                                  "null"
                                ],
                                "minimum": 0
                              },
                              "rir": {
                                "type": [
                                  "number",
                                  "null"
                                ],
                                "minimum": 0
                              },
                              "peso_indicado": {
                                "type": [
                                  "number",
                                  "null"
                                ],
                                "minimum": 0
                              },
                              "notas": {
                                "type": [
                                  "string",
                                  "null"
                                ]
                              }
                            },
                            "required": [
                              "serie",
                              "reps_min",
                              "reps_max",
                              "rir",
                              "peso_indicado",
                              "notas"
                            ]
                          },
                          "minItems": 1
                        },
                        "rir": {
                          "type": [
                            "number",
                            "null"
                          ],
                          "minimum": 0
                        },
                        "rpe": {
                          "type": [
                            "number",
                            "null"
                          ],
                          "minimum": 1,
                          "maximum": 10
                        },
                        "tempo": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "descanso_seg": {
                          "type": [
                            "integer",
                            "null"
                          ],
                          "minimum": 0
                        },
                        "peso_indicado": {
                          "type": [
                            "number",
                            "null"
                          ],
                          "minimum": 0
                        },
                        "unidad": {
                          "enum": [
                            "kg",
                            "lb",
                            null
                          ]
                        },
                        "grupo": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "pattern": "^[A-Z]$"
                        },
                        "tecnica": {
                          "enum": [
                            "superserie",
                            "dropset",
                            "rest_pause",
                            "myo_reps",
                            "parciales",
                            "pausa",
                            "cluster",
                            "otra",
                            null
                          ]
                        },
                        "notas": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      },
                      "required": [
                        "orden",
                        "nombre",
                        "grupos_musculares",
                        "series",
                        "series_calentamiento",
                        "tipo_reps",
                        "reps_min",
                        "reps_max",
                        "series_detalle",
                        "rir",
                        "rpe",
                        "tempo",
                        "descanso_seg",
                        "peso_indicado",
                        "unidad",
                        "grupo",
                        "tecnica",
                        "notas"
                      ]
                    }
                  },
                  "cardio": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "maquina": {
                          "type": "string",
                          "minLength": 1
                        },
                        "momento": {
                          "enum": [
                            "antes",
                            "despues",
                            "separado",
                            null
                          ]
                        },
                        "meta_tipo": {
                          "enum": [
                            "tiempo",
                            "calorias",
                            "distancia"
                          ]
                        },
                        "meta_valor": {
                          "type": "number",
                          "exclusiveMinimum": 0
                        },
                        "inclinacion_pct": {
                          "type": [
                            "number",
                            "null"
                          ],
                          "minimum": 0
                        },
                        "velocidad": {
                          "type": [
                            "number",
                            "null"
                          ],
                          "minimum": 0
                        },
                        "velocidad_unidad": {
                          "enum": [
                            "km/h",
                            "mph",
                            null
                          ]
                        },
                        "nivel": {
                          "type": [
                            "number",
                            "null"
                          ],
                          "minimum": 0
                        },
                        "fc_objetivo": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "notas": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      },
                      "required": [
                        "maquina",
                        "momento",
                        "meta_tipo",
                        "meta_valor",
                        "inclinacion_pct",
                        "velocidad",
                        "velocidad_unidad",
                        "nivel",
                        "fc_objetivo",
                        "notas"
                      ]
                    }
                  }
                },
                "required": [
                  "id",
                  "nombre",
                  "dia_semana",
                  "tipo_dia_dieta",
                  "ejercicios",
                  "cardio"
                ]
              },
              "minItems": 1
            }
          },
          "required": [
            "nombre",
            "fecha_inicio",
            "notas_generales",
            "dias"
          ]
        }
      ]
    },
    "dieta": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "nombre": {
              "type": "string",
              "minLength": 1
            },
            "fecha_inicio": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            },
            "agua_litros": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "notas_generales": {
              "type": [
                "string",
                "null"
              ]
            },
            "tipos_dia": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^TD[0-9]+$"
                  },
                  "nombre": {
                    "type": "string",
                    "minLength": 1
                  },
                  "es_descanso": {
                    "type": "boolean"
                  },
                  "macros_objetivo": {
                    "anyOf": [
                      {
                        "type": "null"
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "kcal": {
                            "type": [
                              "number",
                              "null"
                            ],
                            "minimum": 0
                          },
                          "proteina_g": {
                            "type": [
                              "number",
                              "null"
                            ],
                            "minimum": 0
                          },
                          "carbohidratos_g": {
                            "type": [
                              "number",
                              "null"
                            ],
                            "minimum": 0
                          },
                          "grasa_g": {
                            "type": [
                              "number",
                              "null"
                            ],
                            "minimum": 0
                          }
                        },
                        "required": [
                          "kcal",
                          "proteina_g",
                          "carbohidratos_g",
                          "grasa_g"
                        ]
                      }
                    ]
                  },
                  "comidas": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "orden": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "nombre": {
                          "type": "string",
                          "minLength": 1
                        },
                        "hora": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
                        },
                        "alimentos": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                              "nombre": {
                                "type": "string",
                                "minLength": 1
                              },
                              "cantidad": {
                                "type": [
                                  "number",
                                  "null"
                                ],
                                "minimum": 0
                              },
                              "unidad": {
                                "enum": [
                                  "g",
                                  "ml",
                                  "pieza",
                                  "taza",
                                  "cda",
                                  "cdita",
                                  "scoop",
                                  "rebanada",
                                  "porcion",
                                  "al_gusto"
                                ]
                              },
                              "opciones": {
                                "type": "array",
                                "items": {
                                  "type": "object",
                                  "additionalProperties": false,
                                  "properties": {
                                    "nombre": {
                                      "type": "string",
                                      "minLength": 1
                                    },
                                    "cantidad": {
                                      "type": [
                                        "number",
                                        "null"
                                      ],
                                      "minimum": 0
                                    },
                                    "unidad": {
                                      "enum": [
                                        "g",
                                        "ml",
                                        "pieza",
                                        "taza",
                                        "cda",
                                        "cdita",
                                        "scoop",
                                        "rebanada",
                                        "porcion",
                                        "al_gusto"
                                      ]
                                    }
                                  },
                                  "required": [
                                    "nombre",
                                    "cantidad",
                                    "unidad"
                                  ]
                                }
                              },
                              "notas": {
                                "type": [
                                  "string",
                                  "null"
                                ]
                              }
                            },
                            "required": [
                              "nombre",
                              "cantidad",
                              "unidad",
                              "opciones",
                              "notas"
                            ]
                          }
                        },
                        "notas": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      },
                      "required": [
                        "orden",
                        "nombre",
                        "hora",
                        "alimentos",
                        "notas"
                      ]
                    },
                    "minItems": 1
                  }
                },
                "required": [
                  "id",
                  "nombre",
                  "es_descanso",
                  "macros_objetivo",
                  "comidas"
                ]
              },
              "minItems": 1
            },
            "suplementos": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "nombre": {
                    "type": "string",
                    "minLength": 1
                  },
                  "dosis": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "momento": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "hora": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
                  },
                  "solo_tipos_dia": {
                    "type": [
                      "array",
                      "null"
                    ],
                    "items": {
                      "type": "string",
                      "pattern": "^TD[0-9]+$"
                    }
                  },
                  "notas": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "nombre",
                  "dosis",
                  "momento",
                  "hora",
                  "solo_tipos_dia",
                  "notas"
                ]
              }
            }
          },
          "required": [
            "nombre",
            "fecha_inicio",
            "agua_litros",
            "notas_generales",
            "tipos_dia",
            "suplementos"
          ]
        }
      ]
    },
    "dudas": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "formato",
    "version",
    "rutina",
    "dieta",
    "dudas"
  ],
  "anyOf": [
    {
      "properties": {
        "rutina": {
          "type": "object"
        }
      }
    },
    {
      "properties": {
        "dieta": {
          "type": "object"
        }
      }
    }
  ]
}